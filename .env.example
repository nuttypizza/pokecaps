# Postgres connection string (local Postgres, Neon, Supabase...)
DATABASE_URL=postgres://user:password@localhost:5432/pokecaps
# Optional. Free key from https://dev.pokemontcg.io raises the limit from 1,000 to 20,000 requests a day.
POKEMONTCG_API_KEY=
# api | github | auto (default: try the API, fall back to the GitHub data repo)
SYNC_SOURCE=auto
